# =============================================================================
# Robinhood Chain Token Screener — configuration
#
# Copy to `.env` and edit. Every value below is the safe default; a copy of this
# file with no edits runs in ALERT_ONLY mode and cannot place an order.
#
# THRESHOLDS ARE THE PRODUCT. Read docs/ASSUMPTIONS.md before loosening any of
# them — each one exists because of a specific failure mode.
# =============================================================================

# --------------------------------------------------------------------- core
# ALERT_ONLY | PAPER | LIVE
# ALERT_ONLY : screen + alert. No orders of any kind. <-- start here
# PAPER      : screen + alert + simulated orders.
# LIVE       : screen + alert + REAL orders on OKX. Requires everything below.
RUN_MODE=ALERT_ONLY
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/screener.db
TIMEZONE=UTC

# Kill switch. Any one of these stops all execution:
#   1. KILL_SWITCH=true here
#   2. `touch ./KILL_SWITCH`  (instant, no restart needed)
#   3. POST /kill-switch/engage
KILL_SWITCH=false
KILL_SWITCH_FILE=./KILL_SWITCH

# ------------------------------------------------ Robinhood Chain: Node API
# Standard Ethereum JSON-RPC endpoint. Any Orbit-compatible provider works.
# This is the highest-trust source in the system: it only depends on standards
# (JSON-RPC, ERC-20 ABI, EIP-1967), not on a vendor's response shape.
RH_NODE_RPC_URL=
RH_NODE_WS_URL=
# Leave blank until confirmed — `python scripts/probe_endpoints.py` reads the
# live value via eth_chainId. Do not guess: it is also the OKX `chainIndex`.
RH_CHAIN_ID=
RH_NODE_TIMEOUT_S=15

# ------------------------------------------------ Robinhood Chain: Data API
# Indexed data. DISABLED BY DEFAULT because the exact request/response contract
# is not verified in this repo — see docs/ENDPOINTS.md. Turn on only after
# probing, and adjust the path templates to match what your account actually
# serves. Everything still works with this off; holder metrics then come from
# the explorer and on-chain logs instead.
RH_DATA_ENABLED=false
RH_DATA_BASE_URL=
RH_DATA_API_KEY=
RH_DATA_PATH_TOKEN_LIST=/tokens
RH_DATA_PATH_TOKEN_META=/tokens/{address}
RH_DATA_PATH_TOKEN_HOLDERS=/tokens/{address}/holders
RH_DATA_PATH_TOKEN_TRANSFERS=/tokens/{address}/transfers

# ---------------------------------------------------- Explorer (Blockscout)
# Free. Supplies contract source-verification status, which is a hard gate.
EXPLORER_ENABLED=true
EXPLORER_BASE_URL=https://robinhoodchain.blockscout.com
EXPLORER_TIMEOUT_S=15

# -------------------------------------------------------------- OKX Market
# Web3/DEX market data: token search, price, liquidity, holders.
OKX_MARKET_ENABLED=true
OKX_WEB3_BASE_URL=https://web3.okx.com
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_PROJECT_ID=
OKX_MARKET_TIMEOUT_S=20

# ------------------------------------------------------------- OKX Trading
# SEPARATE credentials from the market key. Give this key SPOT TRADE ONLY —
# never withdrawal permission — and IP-allowlist it. See docs/SECURITY_CHECKLIST.md.
OKX_CEX_BASE_URL=https://www.okx.com
OKX_TRADE_API_KEY=
OKX_TRADE_API_SECRET=
OKX_TRADE_API_PASSPHRASE=
# true => OKX demo trading (x-simulated-trading: 1). Keep true until you have
# watched paper results for days, not hours.
OKX_SIMULATED=true
OKX_TRADE_TIMEOUT_S=20
OKX_QUOTE_CCY=USDT

# ---------------------------------------------------------- Oracle / price
# Optional. Only useful for assets that actually have a feed on this chain
# (normally the quote asset, not the microcap being screened).
CHAINLINK_ENABLED=false
CHAINLINK_FEEDS_JSON={}
# Max disagreement between independent price sources before trading is refused.
PRICE_MAX_SOURCE_DIVERGENCE=0.05

# ------------------------------------------------------------------ timing
INGEST_INTERVAL_S=300
SCORE_INTERVAL_S=300
MAX_TOKENS_PER_CYCLE=60
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE_S=1.0
HTTP_RATE_LIMIT_RPS=5

# =============================================================================
# HARD RISK GATES — failing any of these makes a buy impossible
# =============================================================================
MIN_LIQUIDITY_USD=150000
MIN_LIQUIDITY_USD_LIVE=400000
MAX_SLIPPAGE_BPS=150
MAX_SPREAD_BPS=80
MIN_VOLUME_24H_USD=100000
MAX_VOLUME_TO_LIQUIDITY_RATIO=8.0
MIN_VOLUME_TO_LIQUIDITY_RATIO=0.05
MAX_SINGLE_WINDOW_VOLUME_SHARE=0.35

MAX_TOP1_HOLDER_PCT=12
MAX_TOP10_HOLDER_PCT=40
MIN_UNIQUE_HOLDERS=300
MIN_HOLDER_GROWTH_24H_PCT=-5
MAX_HOLDER_GROWTH_24H_PCT=400

MIN_TOKEN_AGE_HOURS=24
MAX_TOKEN_AGE_HOURS_FOR_EARLY=1080
MIN_TX_COUNT_24H=200

# Anti-chase. Raising these is how you end up buying tops.
MAX_PRICE_CHANGE_24H_PCT=60
MAX_PRICE_VS_7D_BASE_PCT=120
MAX_PRICE_VS_ATH_DRAWDOWN_REQUIRED_PCT=15

MIN_BUY_RATIO=0.35
MAX_BUY_RATIO=0.72

MAX_SNIPER_WALLET_PCT=15
MAX_BUNDLED_BUY_PCT=20

MIN_DAYS_TO_MAJOR_UNLOCK=14
MAJOR_UNLOCK_PCT_OF_SUPPLY=5

# A good score must persist before it counts.
STABILITY_REQUIRED_SNAPSHOTS=3
STABILITY_MAX_SCORE_STDEV=8

# ----------------------------------------------------------- score cutoffs
SCORE_ALERT_MIN=60
SCORE_PAPER_BUY_MIN=72
SCORE_LIVE_BUY_MIN=78

# --------------------------------------------------------- position sizing
# Start small enough that a total loss is genuinely irrelevant to you.
POSITION_USD=25
MAX_EXPOSURE_PER_TOKEN_USD=50
MAX_EXPOSURE_DAILY_USD=200
MAX_OPEN_POSITIONS=5
MAX_ORDERS_PER_DAY=10
LIMIT_OFFSET_BPS=25
ORDER_TTL_S=300
PAPER_ASSUMED_TOUCH_BPS=60

# ------------------------------------------------------------------ safe mode
SAFE_MODE_REF_INSTRUMENT=BTC-USDT
SAFE_MODE_REF_MOVE_1H_PCT=4.0

# ------------------------------------------------------------------ alerting
ALERT_CONSOLE=true
ALERT_FILE=./data/alerts.log
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Minimum state that triggers a notification: WATCH | ALERT | PAPER_BUY | LIVE_BUY
ALERT_MIN_STATE=ALERT
